# Auth (admin login). CHANGE THESE before any real deployment.
AUTH_JWT_KEY=dev-only-insecure-signing-key-change-me-please-32+chars
AUTH_JWT_HOURS=12
AUTH_OWNER_EMAIL=owner@local
AUTH_OWNER_PASSWORD=changeme123
AUTH_OWNER_NAME=Owner

POLZA_ENABLED=false
POLZA_API_KEY=
POLZA_BASE_URL=https://polza.ai/api/v1
POLZA_CHAT_COMPLETION_PATH=/chat/completions
POLZA_DEFAULT_MODEL=openai/gpt-5.5
POLZA_IMAGE_MODEL=openai/gpt-5.4-image-2
POLZA_TIMEOUT_SECONDS=180

TELEGRAM_BOT_TOKEN=
TELEGRAM_MODERATION_CHAT_ID=
TELEGRAM_MODERATOR_CHAT_IDS=
TELEGRAM_PROXY_ENABLED=true
TELEGRAM_PROXY_TYPE=Http
TELEGRAM_PROXY_HOST=
TELEGRAM_PROXY_PORT=0
TELEGRAM_PROXY_USERNAME=
TELEGRAM_PROXY_PASSWORD=

# Niche profile for the very first channel (gaming | vtubing). Custom profiles: drop JSON into ./profiles
SEED_DEFAULT_PROFILE=vtubing

WORKER_ENABLED=false
WORKER_INTERVAL_MINUTES=15
WORKER_MAX_POSTS_PER_RUN=1

# All-day parsing into the "Сегодня" pool (no AI spend except AI-search sources)
INGEST_ENABLED=true
INGEST_INTERVAL_MINUTES=10

# Reddit "script" app (free, reddit.com/prefs/apps). Without it anonymous JSON is used, which many IPs get 403/429 on;
# with wspanel configured the listing is fetched through the remote browser as a fallback.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=linux:tg-autoposter:v0.2 (news aggregator)

# Evening digest scheduler (per-channel time is set in the admin, default 20:00 channel-local)
DIGEST_ENABLED=true
DIGEST_CHECK_INTERVAL_MINUTES=5

# wspanel — remote logged-in Chrome (X/Twitter collector; also fetches t.me previews when enabled)
WSPANEL_ENABLED=false
WSPANEL_BASE_URL=https://144.31.171.41
WSPANEL_API_KEY=
WSPANEL_PROFILE=
WSPANEL_PROGRAM=google-chrome
WSPANEL_WAIT_MS=4000
WSPANEL_INSECURE_TLS=true
WSPANEL_USE_FOR_TELEGRAM=true

VITE_API_URL=http://localhost:5000

POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=5000
ADMIN_HOST_PORT=5173
